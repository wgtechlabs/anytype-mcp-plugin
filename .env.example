# Generate distinct 32+ character random secrets; never commit your .env.
MCP_TOKEN=
OWNER_TOKEN=
ANYTYPE_API_URL=http://127.0.0.1:31012
ANYTYPE_API_KEY=
# Optional secret: set privately before setup to join an existing space.
# Accepts a web invite/<cid>#<key> URL or anytype://invite/?cid=...&key=...
# Keep quotes around a .env value so the #key fragment is preserved.
# ANYTYPE_INVITE_LINK=""
# Optional explicit IDs. Omit for automatic invite target or sandbox access.
# An explicitly empty value denies all spaces and overrides automatic selection.
# ANYTYPE_ALLOWED_SPACES=
ANYTYPE_API_VERSION=v1
ENABLE_EXPERIMENTAL_V2=false
READ_ONLY=true
HOST=127.0.0.1
PORT=31013
PUBLIC_URL=http://127.0.0.1:31013
# Exact callbacks copied from the connecting client's setup, comma-separated.
OAUTH_REDIRECT_URIS=
REQUEST_TIMEOUT_MS=15000
# Only for local Docker with a loopback-published port; never enable for hosted traffic.
ALLOW_INSECURE_HTTP=false
